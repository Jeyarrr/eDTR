NODE_ENV=development
PORT=3001
VITE_PORT=5173
APP_URL=http://localhost:5173
# Leave empty in development to use an isolated local PostgreSQL cluster.
# Set DATABASE_URL and a SESSION_SECRET of at least 32 characters in production.
DATABASE_URL=
SESSION_SECRET=
LOCAL_POSTGRES_PORT=5433
# Windows local bootstrap detects C:/Program Files/PostgreSQL/18/bin.
# POSTGRES_BIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=eDTR <noreply@example.com>

# Hosted PostgreSQL/Vercel (server-side environment variables, never VITE_*):
# Neon: DATABASE_URL = pooled URI; DIRECT_DATABASE_URL = direct URI.
# DATABASE_URL: Supabase Transaction pooler URI, port 6543.
# DIRECT_DATABASE_URL: Session pooler URI, port 5432, for local migration/admin commands.
DIRECT_DATABASE_URL=
DATABASE_SSL=false
# Optional Supabase root certificate PEM if your endpoint requires a custom CA.
DATABASE_SSL_CA=
# In production: NODE_ENV=production, APP_URL=https://your-project.vercel.app
# SESSION_SECRET: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
